{
  "defaults": {
    "concurrency": 1,
    "standard": "WCAG2AA",
    "timeout": 60000,
    "useIncognitoBrowser": true,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    }
  },
  "urls": [
    "http://localhost:4173/day-01",
    "http://localhost:4173/day-02",
    "http://localhost:4173/day-03",
    "http://localhost:4173/day-04",
    {
      "url": "http://localhost:4173/day-05",
      "hideElements": ".axe-ignore"
    }
  ]
}
