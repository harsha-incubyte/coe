{
  "name": "centre-of-excellence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "msw-init": "msw init public/ --save",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:a11y": "pa11y-ci",
    "test:a11y:ci": "npm run build && start-server-and-test preview http://localhost:4173 test:a11y",
    "test:all": "npm run lint && npm run test:run && npm run cy:run && npm run test:a11y:ci"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "styled-components": "^6.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.3",
    "cypress": "^15.13.1",
    "cypress-axe": "^1.7.0",
    "cypress-plugin-tab": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "pa11y-ci": "^4.1.0",
    "start-server-and-test": "^3.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
