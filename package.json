{
  "name": "centre-of-excellence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "msw-init": "msw init public/ --save",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:ci": "start-server-and-test start http://localhost:3000 cy:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "pa11y-ci",
    "test:a11y:ci": "start-server-and-test start http://localhost:3000 test:a11y",
    "pretest:all": "lsof -ti :3000 | xargs kill -9 || true",
    "test:all": "npm run lint && npm run test:run && npm run build && start-server-and-test start http://localhost:3000 \"npm run cy:run && npm run test:a11y\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:delete-conversations": "ts-node scripts/delete-conversations.ts",
    "rag:fetch": "tsx scripts/fetch-pubmed.ts",
    "rag:fetch:all": "tsx scripts/fetch-pubmed.ts --all --count 60",
    "rag:test": "tsx scripts/test-rag-index.ts",
    "prepare": "husky",
    "test:size": "size-limit",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "ci:status": "gh run list --limit 5",
    "ci:watch": "gh run watch",
    "ci:logs": "gh run view --log"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "minisearch": "^7.1.1",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "prisma": "^5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.5",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^3.2.7",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-app": "^12.1.0",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-onboarding": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.11.3",
    "babel-plugin-styled-components": "^2.1.4",
    "chromatic": "^16.8.0",
    "cypress": "^15.13.1",
    "cypress-axe": "^1.7.0",
    "cypress-plugin-tab": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.2",
    "pa11y-ci": "^4.1.0",
    "playwright": "^1.59.1",
    "size-limit": "^12.1.0",
    "start-server-and-test": "^3.0.2",
    "storybook": "8.6.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "vite-plugin-babel": "^1.6.0",
    "vitest": "^3.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/**/*.js",
      "limit": "600 KB"
    }
  ]
}
